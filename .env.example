# Copy to .env. This file has no real credentials.
SITE_PASSWORD=change-this-private-password
DATA_DIR=./data
GENERATION_MODE=simulation
IMAGE25_BASE_URL=https://task-api-1-cn.65535.space
IMAGE25_API_KEY=
IMAGE25_MODEL=
# Experimental generation is blocked until operator explicitly acknowledges research limits.
IMAGE25_EXPERIMENTAL=false
IMAGE25_QUALITY=
SOURCE_STRATEGY=full
SEGMENTATION_MODEL_DIR=./.models/slimsam
SEGMENTATION_DEVICE=cpu
HOST=127.0.0.1
PORT=8787

# Optional free transactional email (for example Brevo SMTP).
# Turn verification on only after all SMTP fields work.
PUBLIC_BASE_URL=http://127.0.0.1:8787
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=拾影
SMTP_USE_TLS=true
